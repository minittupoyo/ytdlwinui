<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="YtdlWinUI.MainPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:YtdlWinUI">
 <Grid Padding="24,20,24,24" RowSpacing="16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <InfoBar IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}" Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
   Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay, Converter={StaticResource NoticeKindToInfoBarSeverityConverter}}"
   AutomationProperties.AutomationId="StatusNotice"/>
  <TextBox Grid.Row="1" Header="動画またはプレイリストの URL" PlaceholderText="https://..."
   Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
   AutomationProperties.AutomationId="UrlInput"/>
  <Grid Grid.Row="2" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBox Header="保存先" IsReadOnly="True" Text="{x:Bind ViewModel.OutputPath, Mode=OneWay}" AutomationProperties.AutomationId="OutputPath"/>
   <Button Grid.Column="1" VerticalAlignment="Bottom" Click="PickOutputFolder_Click" ToolTipService.ToolTip="保存先フォルダーを選択" AutomationProperties.Name="保存先を選択" AutomationProperties.AutomationId="SelectOutputFolderButton">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B7;"/><TextBlock Text="選択"/></StackPanel>
   </Button>
  </Grid>
  <Grid Grid.Row="3" RowSpacing="6">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
   <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
    IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"/>
  </Grid>
  <Grid Grid.Row="4" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged" AutomationProperties.AutomationId="MainViewSelector">
    <SelectorBarItem Text="設定" Icon="Setting" IsSelected="True"/><SelectorBarItem Text="ログ" Icon="Document"/>
   </SelectorBar>
   <ScrollViewer x:Name="SettingsView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Padding="2,4,12,12">
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ComboBox Header="フォーマット" ItemsSource="{x:Bind ViewModel.Formats, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="FormatSelector"/>
      <ComboBox Grid.Column="1" Header="品質" ItemsSource="{x:Bind ViewModel.QualityOptions, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="QualitySelector"/>
     </Grid>
     <TextBox Header="ファイル名テンプレート" Text="{x:Bind ViewModel.FilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="FilenameTemplate"/>
     <StackPanel Spacing="8">
      <TextBlock Text="ブラウザーCookie" Style="{StaticResource BodyStrongTextBlockStyle}"/>
      <Grid ColumnSpacing="12">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ComboBox Header="ブラウザー" ItemsSource="{x:Bind ViewModel.CookieBrowsers, Mode=OneWay}"
        SelectedItem="{x:Bind ViewModel.SelectedCookieBrowser, Mode=TwoWay}" HorizontalAlignment="Stretch"
        AutomationProperties.AutomationId="CookieBrowser"/>
       <ComboBox Grid.Column="1" Header="プロファイル" ItemsSource="{x:Bind ViewModel.CookieProfiles, Mode=OneWay}"
        DisplayMemberPath="DisplayName" SelectedItem="{x:Bind ViewModel.SelectedCookieProfile, Mode=TwoWay}"
        IsEnabled="{x:Bind ViewModel.HasCookieProfiles, Mode=OneWay}" HorizontalAlignment="Stretch"
        AutomationProperties.AutomationId="CookieProfile"/>
      </Grid>
      <TextBlock Text="{x:Bind ViewModel.CookieProfileHint, Mode=OneWay}"
       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
     </StackPanel>
     <Grid ColumnSpacing="20" RowSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <CheckBox Content="プレイリストモード" IsChecked="{x:Bind ViewModel.PlaylistMode, Mode=TwoWay}" IsEnabled="{x:Bind local:MainPage.Not(ViewModel.AlbumMode), Mode=OneWay}" AutomationProperties.AutomationId="PlaylistMode"/>
      <CheckBox Grid.Column="1" Content="サムネイルを埋め込む" IsChecked="{x:Bind ViewModel.EmbedThumbnail, Mode=TwoWay}" AutomationProperties.AutomationId="EmbedThumbnail"/>
      <CheckBox Grid.Row="1" Content="アルバムモード" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsAudioFormat), Mode=OneWay}" IsChecked="{x:Bind ViewModel.AlbumMode, Mode=TwoWay}" AutomationProperties.AutomationId="AlbumMode"/>
      <CheckBox Grid.Row="1" Grid.Column="1" Content="サムネイルを正方形にクロップ" IsChecked="{x:Bind ViewModel.CropThumbnail, Mode=TwoWay}" AutomationProperties.AutomationId="CropThumbnail"/>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="LogView" Grid.Row="1" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.ClearLogCommand}" Content="ログを消去" AutomationProperties.AutomationId="ClearLogButton"/>
    <TextBox Grid.Row="1" Margin="0,8,0,0" Padding="8,6"
     Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
     FontFamily="Consolas" FontSize="12"
     ScrollViewer.VerticalScrollBarVisibility="Auto"
     ScrollViewer.HorizontalScrollBarVisibility="Auto"
     AutomationProperties.Name="ダウンロードログ"
     AutomationProperties.AutomationId="DownloadLog"/>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
   <Button Click="OpenAppSettings_Click" ToolTipService.ToolTip="アプリ設定"
    AutomationProperties.Name="アプリ設定" AutomationProperties.AutomationId="AppSettingsButton">
    <FontIcon Glyph="&#xE713;"/>
   </Button>
   <Button Content="キャンセル" Command="{x:Bind ViewModel.CancelCommand}" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsBusy), Mode=OneWay}" AutomationProperties.AutomationId="CancelButton"/>
   <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.DownloadCommand}" AutomationProperties.AutomationId="DownloadButton">
    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;"/><TextBlock Text="ダウンロード"/></StackPanel>
   </Button>
  </StackPanel>
  <ContentDialog x:Name="AppSettingsDialog" Grid.RowSpan="6" Title="アプリ設定"
   CloseButtonText="閉じる" DefaultButton="Close" AutomationProperties.AutomationId="AppSettingsDialog">
   <StackPanel Spacing="20" MinWidth="480">
    <StackPanel Spacing="8">
     <TextBlock Text="外部ツール" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBlock Text="{x:Bind ViewModel.DependencyStatus, Mode=OneWay}"
      Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
      AutomationProperties.AutomationId="AppDependencyStatus"/>
     <StackPanel Spacing="6" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsInstallingTools), Mode=OneWay}">
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
      <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}"
       IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"/>
     </StackPanel>
     <StackPanel Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
       <Button Content="不足ツールを自動インストール" Command="{x:Bind ViewModel.InstallToolsCommand}"
        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.HasMissingTools), Mode=OneWay}"
        AutomationProperties.AutomationId="InstallToolsButton"/>
       <Button Content="キャンセル" Command="{x:Bind ViewModel.CancelCommand}"
        Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsInstallingTools), Mode=OneWay}"
        AutomationProperties.AutomationId="CancelToolInstallButton"/>
      </StackPanel>
      <Button Content="全ツールを再インストール（開発用）" Command="{x:Bind ViewModel.ForceInstallToolsCommand}"
       HorizontalAlignment="Left" Visibility="{x:Bind local:MainPage.BoolToVisibility(ViewModel.IsDevelopmentBuild), Mode=OneWay}"
       AutomationProperties.AutomationId="ForceInstallToolsButton"/>
     </StackPanel>
     <TextBlock Text="GitHub公式リリースから取得し、SHA-256検証後にアプリ専用フォルダーへ配置します。"
      Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
    </StackPanel>
    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <StackPanel Spacing="8">
     <TextBlock Text="設定の初期化" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBlock Text="保存先、形式、品質、ファイル名、Cookieなどのダウンロード設定を既定値へ戻します。外部ツールとログは削除しません。"
      Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"/>
     <Button Content="ダウンロード設定を初期化" HorizontalAlignment="Left" Click="RequestResetSettings_Click"
      AutomationProperties.AutomationId="ResetSettingsButton"/>
    </StackPanel>
   </StackPanel>
  </ContentDialog>
 </Grid>
</Page>
